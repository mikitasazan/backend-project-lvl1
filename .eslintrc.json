{
  "env": {"es2022": true, "node": true},
  "extends": ["airbnb-base"],
  "parserOptions": {"ecmaVersion": "latest", "sourceType": "module"},
  "rules": {
    "no-console": "off",
    "no-restricted-syntax": "off",
    "import/prefer-default-export": "off",
    "no-param-reassign": "off",
    "import/extensions": "off",
    "no-nested-ternary": "off"
  }
}
